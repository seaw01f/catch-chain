{
  "name": "catch-chain",
  "version": "2.0.1",
  "description": "Fluent, composable, type-safe error matching and recovery for promises",
  "keywords": [
    "promise",
    "catch",
    "error",
    "fluent"
  ],
  "homepage": "https://github.com/seaw01f/catch-chain",
  "bugs": {
    "url": "https://github.com/seaw01f/catch-chain/issues"
  },
  "author": "Lubos Magda <seawolf1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seaw01f/catch-chain.git"
  },
  "packageManager": "pnpm@12.16.1",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist coverage",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dev": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "bunchee",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__test__",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "bunchee": "^7.0.2",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
